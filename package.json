{
  "name": "ordini-tracker",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/ordini-tracker run dev",
    "build": "pnpm --filter @workspace/ordini-tracker run build",
    "preview": "pnpm --filter @workspace/ordini-tracker run serve",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=24"
  }
}
